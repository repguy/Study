# Copy this file to .env and fill in your values
# For Vercel: set these in Project Settings → Environment Variables

# ─── Database (Supabase) ───────────────────────────────────────────────────
# Transaction pooler URL from: Supabase → Project Settings → Database
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# ─── Clerk Auth ───────────────────────────────────────────────────────────
# From: clerk.com → your app → API Keys
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# ─── Session ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ─── Gemini AI (choose one) ───────────────────────────────────────────────
# Option A: Your own Google API key (aistudio.google.com)
GEMINI_API_KEY=AIza...

# Option B: Replit AI proxy (copy from Replit Secrets tab)
# AI_INTEGRATIONS_GEMINI_BASE_URL=
# AI_INTEGRATIONS_GEMINI_API_KEY=

# ─── OpenRouter (optional, for custom model users) ────────────────────────
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=sk-or-...

# ─── Admin ────────────────────────────────────────────────────────────────
# Comma-separated Clerk user IDs with admin access
ADMIN_CLERK_IDS=

# ─── Payment Webhooks (optional) ──────────────────────────────────────────
LEMONSQUEEZY_WEBHOOK_SECRET=
POLAR_WEBHOOK_SECRET=
WHOP_WEBHOOK_SECRET=

    "@workspace/integrations-gemini-ai": "workspace:*",
    "@workspace/integrations-openrouter-ai": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.5.2",
    "http-proxy-middleware": "^4.0.0",
    "openai": "^6.38.0",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {

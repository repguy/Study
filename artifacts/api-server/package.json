{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "exec node --enable-source-maps ./dist/index.mjs",
    "dev:build": "node ./build.mjs && NODE_ENV=development PORT=8080 node --enable-source-maps ./dist/index.mjs",
